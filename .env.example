# Copy to .env and fill in. Without a Paystack key the site runs in DEMO payment mode
# (payments auto-confirm after a few seconds so you can test the full flow).

PORT=3000
# Public address of the site, used for the Paystack return link (e.g. https://gameventures.co.ke)
PUBLIC_URL=http://localhost:3000

ADMIN_EMAIL=admin@gameventures.co.ke
ADMIN_PASSWORD=ChangeMe123!

# --- Paystack (https://dashboard.paystack.com -> Settings -> API Keys & Webhooks) ---
# Use sk_test_... while testing, sk_live_... when you go live.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
# In the Paystack dashboard set the Webhook URL to:  https://your-domain/api/paystack/webhook
